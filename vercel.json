{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "rewrites": [

    {
      "source": "/login",
      "destination": "/login.html"
    },

    {
      "source": "/register",
      "destination": "/register.html"
    },

    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },

    {
      "source": "/world",
      "destination": "/world.html"
    },

    {
      "source": "/politics",
      "destination": "/politics.html"
    }

  ],

  "headers": [

    {
      "source": "/(.*)",

      "headers": [

        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },

        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },

        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }

      ]

    }

  ]

}
